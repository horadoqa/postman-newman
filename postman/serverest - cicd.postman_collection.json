          "name": "LOGIN",
          "item": [
            {
              "name": "CT-API-001 - Realizar Login com Sucesso",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const response = pm.response.json();\r\n\r\n// 1. Validar status\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// 2. Validar mensagem\r\npm.test(\"Login was successful\", function () {\r\n    pm.expect(response.message).to.eql(\"Login realizado com sucesso\");\r\n});\r\n\r\n// 3. Validar estrutura da resposta\r\npm.test(\"Authorization field exists\", function () {\r\n    pm.expect(response).to.have.property(\"authorization\");\r\n});\r\n\r\n// 4. Validar tipo\r\npm.test(\"Authorization is a string\", function () {\r\n    pm.expect(response.authorization).to.be.a(\"string\");\r\n});\r\n\r\n// 5. Validar formato do Bearer Token\r\npm.test(\"Authorization has Bearer format\", function () {\r\n    pm.expect(response.authorization).to.match(/^Bearer\\s.+$/);\r\n});\r\n\r\n// 6. Salvar o token\r\nif (response.authorization) {\r\n    pm.environment.set(\"token\", response.authorization);\r\n}\r\n"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"

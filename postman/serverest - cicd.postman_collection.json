            {
              "name": "Teste de Contrato",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const response = pm.response.json();\r\n\r\n// Status HTTP\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Returned _id matches requested userId\", function () {\r\n    pm.expect(response._id).to.eql(\r\n        pm.environment.get(\"userId\")\r\n    );\r\n});\r\n\r\n// Contrato: campos obrigatórios existem\r\npm.test(\"Response contains required fields\", function () {\r\n    pm.expect(response).to.have.all.keys(\r\n        \"nome\",\r\n        \"email\",\r\n        \"password\",\r\n        \"administrador\",\r\n        \"_id\"\r\n    );\r\n});\r\n\r\n// Tipos dos campos\r\npm.test(\"Response fields have correct types\", function () {\r\n    pm.expect(response.nome).to.be.a(\"string\");\r\n    pm.expect(response.email).to.be.a(\"string\");\r\n    pm.expect(response.password).to.be.a(\"string\");\r\n    pm.expect(response.administrador).to.be.a(\"string\");\r\n    pm.expect(response._id).to.be.a(\"string\");\r\n});\r\n\r\n// Campos não podem estar vazios\r\npm.test(\"Required fields are not empty\", function () {\r\n    pm.expect(response.nome).to.not.be.empty;\r\n    pm.expect(response.email).to.not.be.empty;\r\n    pm.expect(response.password).to.not.be.empty;\r\n    pm.expect(response.administrador).to.not.be.empty;\r\n    pm.expect(response._id).to.not.be.empty;\r\n});\r\n\r\n// Administrador deve ser \"true\" ou \"false\"\r\npm.test(\"Administrador has valid value\", function () {\r\n    pm.expect(response.administrador).to.be.oneOf([\"true\", \"false\"]);\r\n});\r\n\r\n// Email deve possuir formato válido\r\npm.test(\"Email has valid format\", function () {\r\n    pm.expect(response.email).to.match(\r\n        /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/\r\n    );\r\n});\r\n"
                    ]
                  }
                }
